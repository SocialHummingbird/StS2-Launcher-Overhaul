-			for (int j = start, depth = 0; j < source.Count; ++j)
-			{
-				if (source[j].HasBlock(ExceptionBlockType.BeginExceptionBlock)) ++depth;
-				if (source[j].HasBlock(ExceptionBlockType.EndExceptionBlock))
